# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://asastamp:asastamp@localhost:5433/asastamp_dev"

# 管理者ページ (/admin/<この値>) へのアクセスに使う秘密のトークン。
# 推測されないよう十分に長いランダム文字列にすること。例: `openssl rand -hex 24`
ADMIN_SECRET="replace-with-a-long-random-string"
