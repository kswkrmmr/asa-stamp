// asa-stamp data contract
// ログイン・セッションは存在しない。User は名前つきのスタンプカードそのもの。

model User {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt TimestamptzString @default(now())
  stamps    Stamp[]
}

model Stamp {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  // JST基準の暦日（"YYYY-MM-DD"の文字列）。時刻・タイムゾーンを持たない。
  // 注: bare型 `Date`（Temporal.PlainDate）はこのNodeバージョンにグローバルTemporalが
  // 無いため実行時エラーになる（@prisma/orm-target-postgresのコーデックがTemporal必須）。
  // 文字列版のDateStringを使うことで回避している。
  stampedOn DateString
  createdAt TimestamptzString @default(now())

  @@unique([userId, stampedOn])
}

// 常に1行のみ運用する、スタンプ可能時間帯の管理者設定。
model AdminSetting {
  id          Int    @id @default(autoincrement())
  startHour   Int    @default(6)
  startMinute Int    @default(0)
  endHour     Int    @default(9)
  endMinute   Int    @default(0)
  updatedAt   temporal.updatedAtString()
}
